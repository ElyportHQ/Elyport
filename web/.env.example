# ---------------------------------------------------------------- Elysium network
# Mainnet values are not published yet; these defaults point at Elysium Testnet.
NEXT_PUBLIC_ELYSIUM_CHAIN_ID=99801
NEXT_PUBLIC_ELYSIUM_NAME=Elysium Testnet
NEXT_PUBLIC_ELYSIUM_RPC_URL=https://testnet-rpc.elysium.kinetiq.xyz
NEXT_PUBLIC_ELYSIUM_EXPLORER_URL=https://elysium.kinetiq.xyz/testnet-explorer
NEXT_PUBLIC_ELYSIUM_MULTICALL3=0xcA11bde05977b3631167028862bE2a173976CA11

# ---------------------------------------------------------------- Wallets
# Reown (WalletConnect) project ID from https://dashboard.reown.com
NEXT_PUBLIC_REOWN_PROJECT_ID=
NEXT_PUBLIC_SITE_URL=https://elyport.com

# ---------------------------------------------------------------- Elysium contracts
NEXT_PUBLIC_LOCKER_ADDRESS=
NEXT_PUBLIC_VESTING_ADDRESS=
NEXT_PUBLIC_DROP_ADDRESS=
NEXT_PUBLIC_REFUEL_VAULT_ADDRESS=
