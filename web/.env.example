# ---------------------------------------------------------------- Elysium network
# Elysium mainnet (chain 99901). For testnet use 99801, https://testnet-rpc.elysium.kinetiq.xyz
# and https://elysium.kinetiq.xyz/testnet-explorer.
NEXT_PUBLIC_ELYSIUM_CHAIN_ID=99901
NEXT_PUBLIC_ELYSIUM_NAME=Elysium
NEXT_PUBLIC_ELYSIUM_RPC_URL=https://rpc.elysium.kinetiq.xyz
NEXT_PUBLIC_ELYSIUM_EXPLORER_URL=https://elysium.kinetiq.xyz/explorer
# Path formats for links (EIP-3091 explorers use /tx/ and /address/)
NEXT_PUBLIC_ELYSIUM_EXPLORER_TX_PATH=/tx/
NEXT_PUBLIC_ELYSIUM_EXPLORER_ADDRESS_PATH=/address/
NEXT_PUBLIC_ELYSIUM_MULTICALL3=0xcA11bde05977b3631167028862bE2a173976CA11

# ---------------------------------------------------------------- Wallets
# Reown (WalletConnect) project ID from https://dashboard.reown.com
NEXT_PUBLIC_REOWN_PROJECT_ID=ad50cb8494cbdb5f848d883ed7b470b5
# Leave empty to use the Vercel production domain; set to https://elyport.com once the domain is live.
NEXT_PUBLIC_SITE_URL=

# ---------------------------------------------------------------- Elysium contracts
NEXT_PUBLIC_LOCKER_ADDRESS=
NEXT_PUBLIC_VESTING_ADDRESS=
NEXT_PUBLIC_DROP_ADDRESS=
NEXT_PUBLIC_REFUEL_VAULT_ADDRESS=
# First block the contracts were deployed at (speeds up event scans)
NEXT_PUBLIC_DEPLOY_BLOCK=0

# ---------------------------------------------------------------- Refuel deposit contracts (source chains)
NEXT_PUBLIC_REFUEL_DEPOSIT_1=
NEXT_PUBLIC_REFUEL_DEPOSIT_8453=
NEXT_PUBLIC_REFUEL_DEPOSIT_42161=
NEXT_PUBLIC_REFUEL_DEPOSIT_56=
NEXT_PUBLIC_REFUEL_DEPOSIT_999=

# ---------------------------------------------------------------- Relayer (server only, never NEXT_PUBLIC)
RELAYER_PRIVATE_KEY=
CRON_SECRET=
RPC_URL_1=
RPC_URL_8453=
RPC_URL_42161=
RPC_URL_56=
RPC_URL_999=https://rpc.hyperliquid.xyz/evm
ELYSIUM_RPC_URL_SERVER=
RELAYER_LOOKBACK_BLOCKS=3000
REFUEL_FEE_BPS=50
